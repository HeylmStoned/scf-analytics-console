# Optional browser tracking. Set both values to enable it for this deployment.
UMAMI_TRACKER_WEBSITE_ID=
# Comma-separated hostnames, without scheme or path
UMAMI_TRACKER_DOMAINS=

# Umami Cloud API credentials (server-side)
UMAMI_API_KEY=
UMAMI_API_CLIENT_ENDPOINT=https://api.umami.is/v1

# Self-hosted login when UMAMI_API_KEY is empty
UMAMI_URL=
UMAMI_USER=
UMAMI_PASSWORD=

# Live API metrics from the Pulse OTLP collector
OTLP_COLLECTOR_URL=
OTLP_OPERATOR_TOKEN=
