# Umami Cloud API credentials (server-side)
UMAMI_API_KEY=
UMAMI_API_CLIENT_ENDPOINT=https://api.umami.is/v1

# scf-umami-poc-production.up.railway.app website ID
UMAMI_ALPHA=

# Optional Lend.xyz website ID
UMAMI_BETA=

# Self-hosted login when UMAMI_API_KEY is empty
UMAMI_URL=
UMAMI_USER=
UMAMI_PASSWORD=


# Optional comma-separated project IDs whose aggregate totals can be public
UMAMI_PUBLIC_PROJECTS=alpha
